# RCSI Dashboard — Environment Variables
#
# Copy this file to .env and adjust as needed.
# On Render.com, set these in the Dashboard → Environment tab.

# Database — SQLite file path
# On local: relative path (creates db/ directory)
# On Render: absolute path to persistent disk
DATABASE_URL="file:./db/custom.db"

# Z.AI API Key (for AI Research Advisor and Quarterly Report Writer)
# Get one at https://z.ai
ZAI_API_KEY=""

# Node environment
NODE_ENV="production"
